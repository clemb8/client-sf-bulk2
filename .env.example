# End-to-end test configuration for client-sf-bulk2.
#
# Copy to `.env` and fill in. `.env` is gitignored and is excluded from the
# published tarball by the `files` allowlist in package.json.
#
# NOTHING HERE IS NEEDED FOR `npm test`. The unit suite stubs Salesforce at the
# HTTP layer and runs offline. These variables are only read by `npm run test:e2e`.
#
# With none of them set, the e2e suite SKIPS. With some but not all set, it
# FAILS loudly — a half-filled file is a mistake, not a choice.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your org's My Domain URL. No trailing slash.
# The suite REFUSES to run unless this looks like a sandbox, scratch org or
# developer edition, because the ingest tests create and delete records.
SF_INSTANCE_URL=https://your-org--dev.sandbox.my.salesforce.com

# ---------------------------------------------------------------------------
# Authentication — choose ONE of the two blocks below
# ---------------------------------------------------------------------------

# (A) Simplest: paste an access token.
#     Quick to set up, but Salesforce tokens expire; a Bulk job can run for
#     minutes, so a token that expires mid-suite produces a failure that looks
#     like a library bug and is not.
#     Get one with: sf org display --target-org <alias> --json
SF_ACCESS_TOKEN=

# (B) Preferred for repeat runs: OAuth 2.0 client credentials.
#     The suite mints a fresh token per run. Requires a Connected App with the
#     client-credentials flow enabled and a run-as user assigned.
#     If both blocks are filled in, (B) wins.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Defaults to SF_INSTANCE_URL. Set only if your token endpoint differs.
SF_LOGIN_URL=

# ---------------------------------------------------------------------------
# Optional — sensible defaults, override only if needed
# ---------------------------------------------------------------------------

# Salesforce API version the client targets.
SF_API_VERSION=59.0

# sObject the ingest tests insert into and delete from. Must be creatable and
# deletable by the authenticated user, with a required label field.
SF_E2E_OBJECT=Account
SF_E2E_LABEL_FIELD=Name

# Records created per ingest test. Kept small on purpose.
SF_E2E_RECORD_COUNT=3

# Poll interval passed to waitQueryEnd/waitJobEnd, in milliseconds.
SF_E2E_POLL_DELAY_MS=3000

# Per-test timeout, in milliseconds.
SF_E2E_TIMEOUT_MS=180000

# Delete the records the suite creates. Set false only when debugging a
# failure and you want the records left in place to inspect.
SF_E2E_CLEANUP=true

# Escape hatch. Only set true if you have genuinely decided to run the
# record-creating tests against a host that does not look like a sandbox.
SF_E2E_ALLOW_NON_SANDBOX=false
